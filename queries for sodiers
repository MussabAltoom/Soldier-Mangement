-- D1: Does: Analyzes query before index. Rows returned: [X]
EXPLAIN SELECT * FROM soldiers WHERE last_name = 'Mugisha';

-- Does: Creates index on last_name to speed up search. Rows returned: 0
CREATE INDEX idx_soldiers_last_name ON soldiers(last_name);

-- Does: Analyzes query after index (type is now ref, key is idx_soldiers_last_name). Rows returned: [X]
EXPLAIN SELECT * FROM soldiers WHERE last_name = 'Mugisha';

-- D2: Does: Creates a simplified view of soldier details. Rows returned: 0
CREATE VIEW v_soldier_profile AS
SELECT 
    s.soldier_id, 
    CONCAT(s.first_name, ' ', s.last_name) AS full_name, 
    r.rank_name, 
    u.unit_name, 
    u.location, 
    s.status
FROM soldiers s
JOIN ranks r ON s.rank_id = r.rank_id
JOIN units u ON s.unit_id = u.unit_id;

-- D3: Does: Uses view to display soldiers in unit U (3). Rows returned: [X]
SELECT * FROM v_soldier_profile 
WHERE unit_name = (SELECT unit_name FROM units WHERE unit_id = 3) 
ORDER BY full_name ASC;